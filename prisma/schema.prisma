generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clinic {
  id                    String   @id @default(cuid())
  clinicCode            String   @unique @default("MEDICFLOW")
  name                  String   @default("MedicFlow Primary")
  address               String?
  phone                 String?
  email                 String?
  logoUrl               String?
  
  // Settings
  epfRegNo              String?
  etfRegNo              String?
  epfEmployeeRate       Float    @default(8)
  epfEmployerRate       Float    @default(12)
  etfRate               Float    @default(3)
  workingDaysPerMonth   Int      @default(20)
  globalWorkedDayBonus  Float    @default(0)
  globalPunctualBonus   Float    @default(0)
  globalIncomeBonusPct  Float    @default(0)
  
  // Overtime Policy
  otCalculationType     String   @default("Manual") // Manual, Strict, Grace Period
  otGracePeriodMinutes  Int      @default(30)

  // Punctuality Policy
  punctualGraceType     String   @default("Grace Period") // Strict, Grace Period
  punctualGraceMinutes  Int      @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminUsers     AdminUser[]
  employees      Employee[]
  operatingHours ClinicOperatingHours[]
  allowances     Allowance[]
  devices        BiometricDevice[]
  auditLogs      AuditLog[]
  attendanceLogs AttendanceLog[]
  leaveRequests  LeaveRequest[]
  payrollPeriods PayrollPeriod[]
  publicHolidays PublicHoliday[]
}

model AdminUser {
  id        String   @id @default(cuid())
  clinicId  String   @default("default-clinic-id")
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  username  String   @unique
  password  String
  name      String   @default("Clinic Administrator")
  role      String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, username])
}

model Employee {
  id                    String   @id @default(cuid())
  clinicId              String   @default("default-clinic-id")
  clinic                Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  role                  String   @default("Nurse")
  payType               String   @default("Fixed Monthly")
  basicSalary           Float    @default(50000)
  hourlyRate            Float    @default(300)
  sessionRate           Float    @default(0)
  commissionRate        Float    @default(0)
  biometricId           String
  epfEligible           Boolean  @default(true)
  taxable               Boolean  @default(false)
  active                Boolean  @default(true)
  attendanceBonusRate   Float    @default(0)
  punctualBonusRate     Float    @default(0)
  incomeBonusPercentage Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt


  attendanceLogs AttendanceLog[]
  leaveRequests  LeaveRequest[]
  allowances     EmployeeAllowance[]
  customOperatingHours EmployeeOperatingHours[]

  @@unique([clinicId, biometricId])
}

model EmployeeOperatingHours {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 = Sunday, 1 = Monday, etc.
  isOpen     Boolean  @default(true)
  startTime  String   @default("08:30")
  endTime    String   @default("17:00")

  @@unique([employeeId, dayOfWeek])
}

model AttendanceLog {
  id            String   @id @default(cuid())
  clinicId      String   @default("default-clinic-id")
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          String // Format: YYYY-MM-DD
  checkIn       String // Format: HH:mm:ss
  checkOut      String? // Format: HH:mm:ss
  status        String   @default("On-Time") // On-Time, Late, Half-Day, On-Leave, Absent
  overtimeHours Float    @default(0)
  noPayHours    Float    @default(0)
  authMethod    String   @default("Face") // Face, Fingerprint, Card, Manual
  deviceId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LeaveRequest {
  id         String   @id @default(cuid())
  clinicId   String   @default("default-clinic-id")
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String // Annual, Sick, Casual, Unpaid
  startDate  String // Format: YYYY-MM-DD
  endDate    String // Format: YYYY-MM-DD
  reason     String?
  status     String   @default("Pending") // Pending, Approved, Rejected
  appliedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ClinicOperatingHours {
  id        String  @id @default(cuid())
  clinicId  String
  clinic    Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  dayOfWeek Int     // 0 = Sunday, 1 = Monday, etc.
  isOpen    Boolean @default(true)
  startTime String  @default("08:30") // Format: HH:mm
  endTime   String  @default("17:00") // Format: HH:mm

  @@unique([clinicId, dayOfWeek])
}

model Allowance {
  id            String              @id @default(cuid())
  clinicId      String              @default("default-clinic-id")
  clinic        Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  amount        Float
  type          String              @default("Monthly") // Monthly, Daily, Per-Session
  isTaxable     Boolean             @default(false)
  epfApplicable Boolean             @default(false)
  employees     EmployeeAllowance[]
}

model EmployeeAllowance {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allowanceId    String
  allowance      Allowance @relation(fields: [allowanceId], references: [id], onDelete: Cascade)
  overrideAmount Float?
  assignedAt     DateTime  @default(now())
}

model BiometricDevice {
  id           String   @id @default(cuid())
  clinicId     String   @default("default-clinic-id")
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name         String
  model        String   @default("DS-K1T320MFWX")
  serialNumber String   @unique
  location     String   @default("Clinic Main Gate")
  status       String   @default("Connected") // Connected, Disconnected, Syncing
  protocol     String   @default("HTTP Event Push")
  ipAddress    String?
  lastSyncTime DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  clinicId  String   @default("default-clinic-id")
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String
  details   String?
  timestamp DateTime @default(now())
}

model PayrollPeriod {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  month           String   // Format: YYYY-MM
  label           String
  status          String   @default("Finalized") // Draft, Finalized
  finalizedAt     DateTime @default(now())
  grossSalaryPool Float    @default(0)
  netRemittances  Float    @default(0)
  totalEpf        Float    @default(0)
  totalEtf        Float    @default(0)
  totalApit       Float    @default(0)
  employeeCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PublicHoliday {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  date        String   // Format: YYYY-MM-DD
  name        String
  isDoubleOT  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

